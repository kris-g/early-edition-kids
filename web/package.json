{
  "name": "early-edition-kids-dashboard",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently -k -n mock,vite -c cyan,magenta \"npm:mock\" \"npm:dev:to-mock\"",
    "mock": "node --import tsx mock/server.ts",
    "mock:watch": "tsx watch mock/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:mock": "npm run build && concurrently -k -n mock,preview -c cyan,magenta \"npm:mock\" \"npm:preview:to-mock\"",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "dev:to-mock": "EARLY_EDITION_KIDS_API=http://localhost:8090 EARLY_EDITION_KIDS_DASHBOARD_API=http://localhost:8090 vite",
    "preview:to-mock": "EARLY_EDITION_KIDS_API=http://localhost:8090 EARLY_EDITION_KIDS_DASHBOARD_API=http://localhost:8090 vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^5.3.0",
    "globals": "^17.6.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
